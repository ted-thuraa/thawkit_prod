+    return title.closest('[role="dialog"], [role="alertdialog"]') as HTMLElement;
+  };
+
+  it("a USED file can't be deleted: lists where it is used and disables confirm", async () => {
+    const user = userEvent.setup({ pointerEventsCheck: 0 });
+    api.getUsage.mockResolvedValue({
+      data: {
+        total: 2,
+        pages: [{ id: "p1", name: "Landing" }],
+        components: [], layerStyles: [], cmsItems: [],
+        publishedFunnels: [{ id: "f1", name: "Spring sale" }],
+      },
+    });
+    await renderDialog();
+    await startDelete(user, "rootA.png");
+
+    const dlg = await confirmDialog();
+    await waitFor(() => expect(within(dlg).getByText(/can.t be deleted yet/)).toBeTruthy());
+    expect(within(dlg).getByText("Landing")).toBeTruthy();
+    expect(within(dlg).getByText("Spring sale")).toBeTruthy();
+    expect((within(dlg).getByRole("button", { name: "Delete" }) as HTMLButtonElement).disabled).toBe(true);
+    expect(api.deleteAsset).not.toHaveBeenCalled();
+  });
+
+  it("an UNUSED file is deleted via the server and only then disappears", async () => {
+    const user = userEvent.setup({ pointerEventsCheck: 0 });
+    api.getUsage.mockResolvedValue({
+      data: { total: 0, pages: [], components: [], layerStyles: [], cmsItems: [], publishedFunnels: [] },
+    });
+    api.deleteAsset.mockResolvedValue({ ok: true });
+    await renderDialog();
+    await startDelete(user, "rootB.png");
+
+    const dlg = await confirmDialog();
+    await user.click(await within(dlg).findByRole("button", { name: "Delete" }));
+
+    await waitFor(() => expect(api.deleteAsset).toHaveBeenCalledWith("rootB"));
+    await waitFor(() => expect(screen.queryByText("rootB.png")).toBeNull());
+    expect(screen.getByText("rootA.png")).toBeTruthy();
+    expect(toast.success).toHaveBeenCalledWith("Asset deleted");
+  });
+
+  it("a server refusal/failure keeps the file and says so (no optimistic removal)", async () => {
+    const user = userEvent.setup({ pointerEventsCheck: 0 });
+    api.getUsage.mockResolvedValue({
+      data: { total: 0, pages: [], components: [], layerStyles: [], cmsItems: [], publishedFunnels: [] },
+    });
+    api.deleteAsset.mockResolvedValue({ ok: false, inUse: false, error: "The file could not be removed from storage. Nothing was changed — please try again." });
+    await renderDialog();
+    await startDelete(user, "rootB.png");
+    const dlg = await confirmDialog();
+    await user.click(await within(dlg).findByRole("button", { name: "Delete" }));
+
+    await waitFor(() => expect(toast.error).toHaveBeenCalledWith("Unable to delete asset", expect.objectContaining({ description: expect.stringContaining("Nothing was changed") })));
+    expect(screen.getByText("rootB.png")).toBeTruthy(); // still listed
+  });
+});
diff --git a/tests/file-manager/folder-tree.test.ts b/tests/file-manager/folder-tree.test.ts
new file mode 100644
index 0000000..04c0f58
--- /dev/null
+++ b/tests/file-manager/folder-tree.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildAssetFolderPath,
+  flattenAssetFolderTree,
+  getFolderAndDescendantIds,
+  hasChildFolders,
+  isDescendantAssetFolder,
+} from "@/lib/assets/asset-folder-utils";
+import type { AssetFolder } from "@/types/funnel";
+
+const f = (id: string, parent: string | null, name = id, order = 0): AssetFolder => ({
+  id, asset_folder_id: parent, name, depth: 0, order, is_published: false,
+  created_at: "", updated_at: "", deleted_at: null,
+});
+
+const TREE = [
+  f("b", null, "Beta", 1), f("a", null, "Alpha", 0),
+  f("a1", "a", "A-one", 0), f("a2", "a", "A-two", 1), f("a1x", "a1", "Deep"),
+];
+
+describe("flattenAssetFolderTree", () => {
+  it("lists regular folders beneath the root in sibling order, depth-first", () => {
+    const flat = flattenAssetFolderTree(TREE, null, new Set(), 1);
+    expect(flat.map((n) => [n.id, n.depth])).toEqual([
+      ["a", 1], ["a1", 2], ["a1x", 3], ["a2", 2], ["b", 1],
+    ]);
+    expect(flat.map((n) => n.index)).toEqual([0, 1, 2, 3, 4]);
+    expect(flat[1].parentId).toBe("a");
+  });
+
+  it("omits the children of collapsed folders", () => {
+    const flat = flattenAssetFolderTree(TREE, null, new Set(["a"]), 1);
+    expect(flat.map((n) => n.id)).toEqual(["a", "b"]);
+  });
+
+  it("falls back to name for equal order (stable result)", () => {
+    const flat = flattenAssetFolderTree([f("z", null, "Zed"), f("y", null, "Yak")]);
+    expect(flat.map((n) => n.id)).toEqual(["y", "z"]);
+  });
+
+  it("does not render orphans whose parent no longer exists (stale reference)", () => {
+    const flat = flattenAssetFolderTree([f("a", null), f("orphan", "deleted-parent")]);
+    expect(flat.map((n) => n.id)).toEqual(["a"]);
+  });
+
+  it("terminates on corrupt cyclic data", () => {
+    const flat = flattenAssetFolderTree([f("x", "y"), f("y", "x")]);
+    expect(flat).toEqual([]);
+  });
+
+  it("is empty with no folders (root alone is shown by the UI)", () => {
+    expect(flattenAssetFolderTree([], null, new Set(), 1)).toEqual([]);
+  });
+});
+
+describe("tree queries", () => {
+  it("hasChildFolders treats 'root' as the virtual root", () => {
+    expect(hasChildFolders("root", TREE)).toBe(true);
+    expect(hasChildFolders("root", [])).toBe(false);
+    expect(hasChildFolders("a", TREE)).toBe(true);
+    expect(hasChildFolders("b", TREE)).toBe(false);
+  });
+
+  it("isDescendantAssetFolder", () => {
+    expect(isDescendantAssetFolder("a1x", "a", TREE)).toBe(true);
+    expect(isDescendantAssetFolder("a", "a", TREE)).toBe(false);
+    expect(isDescendantAssetFolder("b", "a", TREE)).toBe(false);
+  });
+
+  it("getFolderAndDescendantIds", () => {
+    expect(getFolderAndDescendantIds("a", TREE).sort()).toEqual(["a", "a1", "a1x", "a2"]);
+    expect(getFolderAndDescendantIds("b", TREE)).toEqual(["b"]);
+  });
+
+  it("buildAssetFolderPath", () => {
+    expect(buildAssetFolderPath("a1x", TREE)).toEqual(["Alpha", "A-one", "Deep"]);
+    expect(buildAssetFolderPath(null, TREE)).toEqual([]);
+  });
+});
diff --git a/tests/file-manager/jsdom-polyfills.ts b/tests/file-manager/jsdom-polyfills.ts
new file mode 100644
index 0000000..ea5cddd
--- /dev/null
+++ b/tests/file-manager/jsdom-polyfills.ts
@@ -0,0 +1,18 @@
+// jsdom lacks these browser APIs, which the File Manager's infinite scroll and
+// Radix primitives use. Minimal no-op stand-ins are enough for behavior tests.
+class NoopObserver {
+  observe() {}
+  unobserve() {}
+  disconnect() {}
+  takeRecords() {
+    return [];
+  }
+}
+const g = globalThis as Record<string, unknown>;
+g.IntersectionObserver ??= NoopObserver;
+g.ResizeObserver ??= NoopObserver;
+if (typeof window !== "undefined") {
+  window.HTMLElement.prototype.scrollIntoView ??= () => {};
+  window.HTMLElement.prototype.hasPointerCapture ??= () => false;
+  window.HTMLElement.prototype.releasePointerCapture ??= () => {};
+}
