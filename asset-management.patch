+++ b/tests/assets/process-upload.test.ts
@@ -0,0 +1,235 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  UploadRejectedError,
+  processUploadedFile,
+  type NewAssetInput,
+  type ProcessDeps,
+  type UploadedObject,
+} from "@/lib/assets/process-upload";
+import type { Asset } from "@/types/funnel";
+
+const enc = (s: string) => new TextEncoder().encode(s);
+const SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M0 0h24v24H0z"/></svg>';
+
+function png(w = 100, h = 50): Uint8Array {
+  const b = new Uint8Array(33);
+  b.set([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a], 0);
+  const dv = new DataView(b.buffer);
+  dv.setUint32(8, 13);
+  b.set([0x49, 0x48, 0x44, 0x52], 12);
+  dv.setUint32(16, w);
+  dv.setUint32(20, h);
+  b.set([8, 6, 0, 0, 0], 24);
+  return b;
+}
+
+const CTX = { organizationId: "org_1", userId: "user_1", folderId: null };
+
+function file(over: Partial<UploadedObject> = {}): UploadedObject {
+  return {
+    key: "key_orig",
+    name: "photo.png",
+    size: 33,
+    type: "image/png",
+    ufsUrl: "https://app123.ufs.sh/f/key_orig",
+    ...over,
+  };
+}
+
+function toAsset(input: NewAssetInput): Asset {
+  return {
+    id: "asset_1",
+    filename: input.filename,
+    storage_path: input.storagePath,
+    public_url: input.publicUrl,
+    file_size: input.fileSize,
+    mime_type: input.mimeType,
+    width: input.width,
+    height: input.height,
+    source: "library",
+    asset_folder_id: input.assetFolderId,
+    content: input.content,
+    content_hash: input.contentHash,
+    is_published: false,
+    created_at: "2026-01-01T00:00:00.000Z",
+    updated_at: "2026-01-01T00:00:00.000Z",
+    deleted_at: null,
+  } as Asset;
+}
+
+function makeDeps(over: Partial<ProcessDeps> & { bytes?: Uint8Array } = {}) {
+  const inserted: NewAssetInput[] = [];
+  const deleted: string[] = [];
+  const log = { warn: vi.fn(), error: vi.fn() };
+  const deps: ProcessDeps = {
+    findByStorageKey: vi.fn(async () => null),
+    insertAsset: vi.fn(async (input) => {
+      inserted.push(input);
+      return { asset: toAsset(input), created: true };
+    }),
+    fetchBytes: vi.fn(async () => over.bytes ?? png()),
+    deleteObject: vi.fn(async (key: string) => {
+      deleted.push(key);
+    }),
+    replaceObject: vi.fn(async () => ({
+      key: "key_clean",
+      ufsUrl: "https://app123.ufs.sh/f/key_clean",
+    })),
+    log,
+    ...over,
+  };
+  return { deps, inserted, deleted, log };
+}
+
+describe("processUploadedFile", () => {
+  it("persists metadata for a valid raster image (org from context, real dims)", async () => {
+    const { deps, inserted, deleted } = makeDeps();
+    const asset = await processUploadedFile(file(), CTX, deps);
+    expect(asset.public_url).toBe("https://app123.ufs.sh/f/key_orig");
+    expect(inserted).toHaveLength(1);
+    expect(inserted[0]).toMatchObject({
+      organizationId: "org_1",
+      storagePath: "key_orig",
+      mimeType: "image/png",
+      width: 100,
+      height: 50,
+      content: null,
+    });
+    expect(inserted[0].contentHash).toMatch(/^[0-9a-f]{64}$/);
+    expect(deleted).toEqual([]);
+  });
+
+  it("stores a clean SVG as-is, with sanitized inline content", async () => {
+    const { deps, inserted } = makeDeps({ bytes: enc(SVG) });
+    await processUploadedFile(file({ name: "i.svg", type: "image/svg+xml", key: "k1", ufsUrl: "https://a.ufs.sh/f/k1" }), CTX, deps);
+    expect(deps.replaceObject).not.toHaveBeenCalled();
+    expect(inserted[0]).toMatchObject({ storagePath: "k1", mimeType: "image/svg+xml", width: 24, height: 24 });
+    expect(inserted[0].content).toContain("<svg");
+  });
+
+  it("replaces a dirty SVG with the sanitized file and deletes the original", async () => {
+    const dirty = SVG.replace("<path", '<metadata/><path data-x="1"');
+    const { deps, inserted, deleted } = makeDeps({ bytes: enc(dirty) });
+    await processUploadedFile(file({ name: "i.svg", type: "image/svg+xml" }), CTX, deps);
+    expect(deps.replaceObject).toHaveBeenCalledTimes(1);
+    expect(deleted).toEqual(["key_orig"]);
+    expect(inserted[0].storagePath).toBe("key_clean");
+    expect(inserted[0].publicUrl).toBe("https://app123.ufs.sh/f/key_clean");
+    expect(inserted[0].content).not.toContain("metadata");
+  });
+
+  it("rejects an active SVG and deletes the stored object", async () => {
+    const { deps, inserted, deleted } = makeDeps({ bytes: enc(SVG.replace("<path", "<script>1</script><path")) });
+    await expect(
+      processUploadedFile(file({ name: "i.svg", type: "image/svg+xml" }), CTX, deps),
+    ).rejects.toBeInstanceOf(UploadRejectedError);
+    expect(inserted).toHaveLength(0);
+    expect(deleted).toEqual(["key_orig"]);
+  });
+
+  it("rejects content that doesn't match the declared type and cleans up", async () => {
+    const { deps, deleted } = makeDeps({ bytes: enc("<html>not an image</html>") });
+    await expect(processUploadedFile(file(), CTX, deps)).rejects.toThrow(/valid image/i);
+    expect(deleted).toEqual(["key_orig"]);
+  });
+
+  it("rejects unsupported declared types (video) without fetching bytes", async () => {
+    const { deps, deleted } = makeDeps();
+    await expect(
+      processUploadedFile(file({ name: "v.mp4", type: "video/mp4" }), CTX, deps),
+    ).rejects.toBeInstanceOf(UploadRejectedError);
+    expect(deps.fetchBytes).not.toHaveBeenCalled();
+    expect(deleted).toEqual(["key_orig"]);
+  });
+
+  it("rejects oversize claims", async () => {
+    const { deps } = makeDeps();
+    await expect(
+      processUploadedFile(file({ size: 9 * 1024 * 1024 }), CTX, deps),
+    ).rejects.toThrow(/too large/);
+  });
+
+  it("refuses to fetch from a non-UploadThing host (SSRF guard)", async () => {
+    const { deps } = makeDeps();
+    await expect(
+      processUploadedFile(file({ ufsUrl: "http://169.254.169.254/x" }), CTX, deps),
+    ).rejects.toBeInstanceOf(UploadRejectedError);
+    expect(deps.fetchBytes).not.toHaveBeenCalled();
+  });
+
+  it("DB failure after storage succeeded → deletes the object, generic error", async () => {
+    const { deps, deleted } = makeDeps({
+      insertAsset: vi.fn(async () => {
+        throw new Error("connection reset");
+      }),
+    });
+    await expect(processUploadedFile(file(), CTX, deps)).rejects.toThrow(
+      /could not be saved/i,
+    );
+    expect(deleted).toEqual(["key_orig"]);
+  });
+
+  it("cleanup failure is logged as an orphan with the key, original error still surfaces", async () => {
+    const { deps, log } = makeDeps({
+      insertAsset: vi.fn(async () => {
+        throw new Error("db down");
+      }),
+      deleteObject: vi.fn(async () => {
+        throw new Error("uploadthing down");
+      }),
+    });
+    await expect(processUploadedFile(file(), CTX, deps)).rejects.toBeInstanceOf(UploadRejectedError);
+    expect(log.error).toHaveBeenCalledWith(
+      "asset.orphan",
+      expect.objectContaining({ key: "key_orig" }),
+    );
+  });
+
+  it("DB failure after an SVG replacement cleans up BOTH objects when the original delete failed", async () => {
+    const dirty = SVG.replace("<path", '<metadata/><path');
+    const deleteObject = vi
+      .fn<(k: string) => Promise<void>>()
+      .mockRejectedValueOnce(new Error("first delete fails")) // original, during replace
+      .mockResolvedValue(undefined); // compensating deletes
+    const { deps } = makeDeps({
+      bytes: enc(dirty),
+      deleteObject,
+      insertAsset: vi.fn(async () => {
+        throw new Error("db down");
+      }),
+    });
+    await expect(
+      processUploadedFile(file({ name: "i.svg", type: "image/svg+xml" }), CTX, deps),
+    ).rejects.toBeInstanceOf(UploadRejectedError);
+    expect(deleteObject.mock.calls.map((c) => c[0]).sort()).toEqual(
+      ["key_clean", "key_orig", "key_orig"].sort(),
+    );
+  });
+
+  it("is idempotent: a redelivered callback returns the existing row and does no work", async () => {
+    const existing = toAsset({
+      organizationId: "org_1", assetFolderId: null, filename: "photo.png",
+      storagePath: "key_orig", publicUrl: "https://app123.ufs.sh/f/key_orig",
+      fileSize: 33, mimeType: "image/png", width: 1, height: 1, content: null, contentHash: "x",
+    });
+    const { deps } = makeDeps({ findByStorageKey: vi.fn(async () => existing) });
+    const asset = await processUploadedFile(file(), CTX, deps);
+    expect(asset).toBe(existing);
+    expect(deps.fetchBytes).not.toHaveBeenCalled();
+    expect(deps.insertAsset).not.toHaveBeenCalled();
+  });
+
+  it("concurrent duplicate (insert reports created:false) keeps the winner's object", async () => {
+    const { deps, deleted } = makeDeps({
+      insertAsset: vi.fn(async (input) => ({ asset: toAsset(input), created: false })),
+    });
+    await processUploadedFile(file(), CTX, deps);
+    expect(deleted).toEqual([]); // key_orig is owned by the winning row
+  });
+
+  it("sanitizes the stored filename", async () => {
+    const { deps, inserted } = makeDeps();
+    await processUploadedFile(file({ name: "../../evil.png" }), CTX, deps);
+    expect(inserted[0].filename).not.toMatch(/[\\/]/);
+  });
+});
diff --git a/tests/assets/svg-sanitizer.test.ts b/tests/assets/svg-sanitizer.test.ts
new file mode 100644
index 0000000..d9131e8
--- /dev/null
+++ b/tests/assets/svg-sanitizer.test.ts
@@ -0,0 +1,176 @@
+import { describe, expect, it } from "vitest";
+import {
+  sanitizeSvg,
+  sanitizeSvgForInline,
+} from "@/lib/assets/svg-sanitizer";
+
+const ICON =
+  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><circle cx="12" cy="12" r="3"/></svg>';
+
+const wrap = (inner: string, attrs = "") =>
+  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"${attrs}>${inner}</svg>`;
+
+describe("sanitizeSvg — accepts legitimate icons", () => {
+  it("keeps a typical stroke icon and reports its size", () => {
+    const r = sanitizeSvg(ICON);
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.width).toBe(24);
+    expect(r.height).toBe(24);
+    expect(r.viewBox).toBe("0 0 24 24");
+    expect(r.modified).toBe(false);
+    expect(r.svg).toContain('stroke="currentColor"');
+    expect(r.svg).toContain('<path d="M5 12h14"/>');
+  });
+
+  it("derives size from viewBox when width/height are absent", () => {
+    const r = sanitizeSvg(wrap('<rect width="4" height="4"/>').replace("0 0 10 10", "0 0 48 32"));
+    expect(r.ok && [r.width, r.height]).toEqual([48, 32]);
+  });
+
+  it("strips XML declaration, comments and a plain DOCTYPE", () => {
+    const r = sanitizeSvg(
+      `<?xml version="1.0"?><!DOCTYPE svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd"><!-- hi -->${ICON}`,
+    );
+    expect(r.ok).toBe(true);
+    if (r.ok) {
+      expect(r.svg.startsWith("<svg")).toBe(true);
+      expect(r.svg).not.toContain("DOCTYPE");
+      expect(r.svg).not.toContain("hi");
+      expect(r.modified).toBe(true); // DOCTYPE was dropped
+    }
+  });
+
+  it("allows same-document references and gradients", () => {
+    const r = sanitizeSvg(
+      wrap(
+        '<defs><linearGradient id="g"><stop offset="0" stop-color="#f00"/></linearGradient></defs><rect fill="url(#g)" width="5" height="5"/><use href="#g"/>',
+      ),
+    );
+    expect(r.ok).toBe(true);
+    if (r.ok) expect(r.svg).toContain('fill="url(#g)"');
+  });
+
+  it("keeps harmless inline style declarations only", () => {
+    const r = sanitizeSvg(wrap('<path style="fill:#333;stroke-width:2;position:fixed" d="M0 0"/>'));
+    expect(r.ok).toBe(true);
+    if (r.ok) {
+      expect(r.svg).toContain('style="fill:#333;stroke-width:2"');
+      expect(r.svg).not.toContain("position");
+    }
+  });
+
+  it("drops editor metadata and unknown attributes but flags it", () => {
+    const r = sanitizeSvg(
+      wrap('<sodipodi:namedview id="x"/><path data-name="a" class="c" d="M0 0"/>'),
+    );
+    expect(r.ok).toBe(true);
+    if (r.ok) {
+      expect(r.svg).not.toContain("sodipodi");
+      expect(r.svg).not.toContain("data-name");
+      expect(r.modified).toBe(true);
+    }
+  });
+
+  it("escapes text content", () => {
+    const r = sanitizeSvg(wrap("<text>a &lt; b &amp; c</text>"));
+    expect(r.ok && r.svg).toContain("<text>a &lt; b &amp; c</text>");
+  });
+});
+
+const ATTACKS: Array<[string, string]> = [
+  ["script element", wrap("<script>alert(1)</script>")],
+  ["script in CDATA", wrap("<script><![CDATA[alert(1)]]></script>")],
+  ["uppercase-obfuscated script", wrap("<SCRIPT>alert(1)</SCRIPT>")],
+  ["quoted onload", wrap("", ' onload="alert(1)"')],
+  ["single-quoted handler", wrap('<rect onclick=\'alert(1)\' width="1" height="1"/>')],
+  ["unquoted handler", wrap("<rect onmouseover=alert(1) width=1 height=1 />")],
+  ["handler with odd case", wrap('<rect OnClick="alert(1)"/>')],
+  ["javascript: href on <a>", wrap('<a href="javascript:alert(1)"><rect/></a>')],
+  ["javascript: xlink:href on <a>", wrap('<a xlink:href="javascript:alert(1)"><rect/></a>')],
+  ["entity-encoded javascript: on use", wrap('<use href="&#106;avascript:alert(1)"/>')],
+  ["whitespace-split javascript:", wrap('<use href="java\tscript:alert(1)"/>')],
+  ["external <use>", wrap('<use href="https://evil.example/x.svg#a"/>')],
+  ["external <use> via xlink", wrap('<use xlink:href="//evil.example/x.svg#a"/>')],
+  ["data: <use>", wrap('<use href="data:image/svg+xml;base64,PHN2Zz48L3N2Zz4="/>')],
+  ["foreignObject", wrap('<foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><img src=x onerror=alert(1)></div></foreignObject>')],
+  ["<style> block", wrap("<style>@import url(https://evil.example/x.css);</style>")],
+  ["animate href", wrap('<a><animate attributeName="href" values="javascript:alert(1)"/></a>')],
+  ["<set> href", wrap('<a><set attributeName="href" to="javascript:alert(1)"/></a>')],
+  ["<image> external", wrap('<image href="https://evil.example/t.png"/>')],
+  ["feImage external", wrap('<filter id="f"><feImage href="https://evil.example/t.png"/></filter>')],
+  ["css url() external in attribute", wrap('<rect fill="url(https://evil.example/p)"/>')],
+  ["css url() javascript in style", wrap('<rect style="fill:url(javascript:alert(1))"/>')],
+  ["style expression()", wrap('<rect style="width:expression(alert(1))"/>')],
+  ["internal DOCTYPE entity", '<!DOCTYPE svg [<!ENTITY x "y">]><svg xmlns="http://www.w3.org/2000/svg"/>'],
+  ["billion-laughs style entity", '<!DOCTYPE svg [<!ENTITY a "aaaa"><!ENTITY b "&a;&a;">]><svg xmlns="http://www.w3.org/2000/svg">&b;</svg>'],
+  ["wrong namespace", '<svg xmlns="http://evil.example/ns"><rect/></svg>'],
+  ["non-svg root", "<html><body><script>alert(1)</script></body></html>"],
+  ["two roots", `${ICON}${ICON}`],
+  ["text before root", `hello${ICON}`],
+  ["embedded iframe", wrap('<iframe src="https://evil.example"/>')],
+  ["not xml at all", "this is not an svg"],
+  ["empty", ""],
+  ["NUL byte", wrap("\u0000")],
+];
+
+describe("sanitizeSvg — rejects attack corpus", () => {
+  it.each(ATTACKS)("%s", (_name, input) => {
+    const r = sanitizeSvg(input);
+    expect(r.ok).toBe(false);
+  });
+
+  it("rejects pathologically deep nesting", () => {
+    const deep = "<g>".repeat(80) + "</g>".repeat(80);
+    expect(sanitizeSvg(wrap(deep)).ok).toBe(false);
+  });
+
+  it("rejects excessive node counts", () => {
+    expect(sanitizeSvg(wrap("<rect/>".repeat(7000))).ok).toBe(false);
+  });
+
+  it("rejects oversized input", () => {
+    expect(sanitizeSvg(wrap("<!--" + "a".repeat(600 * 1024) + "-->")).ok).toBe(false);
+  });
+});
+
+describe("sanitizeSvg — output properties", () => {
+  it("is a fixed point (sanitizing output changes nothing)", () => {
+    for (const input of [ICON, wrap('<path d="M0 0" class="x" style="fill:red"/>')]) {
+      const first = sanitizeSvg(input);
+      expect(first.ok).toBe(true);
+      if (!first.ok) continue;
+      const second = sanitizeSvg(first.svg);
+      expect(second.ok && second.svg).toBe(first.svg);
+      expect(second.ok && second.modified).toBe(false);
+    }
+  });
+
+  it("never emits active content for any accepted input", () => {
+    const tricky = wrap(
+      '<text>&lt;script&gt;alert(1)&lt;/script&gt;</text><path d="M0 0" aria-label="&quot; onload=&quot;alert(1)"/>',
+    );
+    const r = sanitizeSvg(tricky);
+    expect(r.ok).toBe(true);
+    if (r.ok) {
+      expect(r.svg).not.toMatch(/<script/i);
+      // the attribute value stays INSIDE its quotes
+      expect(r.svg).toContain('aria-label="&quot; onload=&quot;alert(1)"');
+    }
+  });
+});
+
+describe("sanitizeSvgForInline", () => {
+  it("returns sanitized markup", () => {
+    expect(sanitizeSvgForInline(ICON)).toContain("<svg");
+  });
+  it("returns empty string for rejected / empty / nullish input", () => {
+    expect(sanitizeSvgForInline(wrap("<script>1</script>"))).toBe("");
+    expect(sanitizeSvgForInline("")).toBe("");
+    expect(sanitizeSvgForInline(null)).toBe("");
+    expect(sanitizeSvgForInline(undefined)).toBe("");
+  });
+  it("is stable across repeated calls (cache)", () => {
+    expect(sanitizeSvgForInline(ICON)).toBe(sanitizeSvgForInline(ICON));
+  });
+});
diff --git a/tests/assets/upload-policy.test.ts b/tests/assets/upload-policy.test.ts
new file mode 100644
index 0000000..a0f9778
--- /dev/null
+++ b/tests/assets/upload-policy.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest";
+import {
+  FILE_ROUTE_CONFIG,
+  UPLOADABLE_MIME_TYPES,
+  isTrustedUploadUrl,
+  isUploadableMime,
+  sanitizeFilename,
+  validateUploadCandidate,
+} from "@/lib/assets/upload-policy";
+
+describe("upload policy", () => {
+  it("accepts supported images and SVG", () => {
+    for (const type of UPLOADABLE_MIME_TYPES) {
+      expect(validateUploadCandidate({ name: "a", type, size: 1000 })).toBeNull();
+    }
+  });
+
+  it.each([
+    "video/mp4", "video/webm", "audio/mpeg", "application/pdf", "font/woff2",
+    "text/html", "application/octet-stream", "image/bmp", "image/tiff", "image/jpg", "",
+  ])("rejects %s", (type) => {
+    expect(validateUploadCandidate({ name: "a", type, size: 1000 })).not.toBeNull();
+    expect(isUploadableMime(type)).toBe(false);
+  });
+
+  it("enforces per-type size limits", () => {
+    expect(validateUploadCandidate({ name: "a.png", type: "image/png", size: 8 * 1024 * 1024 })).toBeNull();
+    expect(validateUploadCandidate({ name: "a.png", type: "image/png", size: 8 * 1024 * 1024 + 1 })).toMatch(/too large/);
+    expect(validateUploadCandidate({ name: "a.svg", type: "image/svg+xml", size: 512 * 1024 + 1 })).toMatch(/too large/);
+  });
+
+  it("rejects empty and overlong names", () => {
+    expect(validateUploadCandidate({ name: "a", type: "image/png", size: 0 })).toMatch(/empty/);
+    expect(validateUploadCandidate({ name: "x".repeat(300), type: "image/png", size: 10 })).not.toBeNull();
+  });
+
+  it("route config has explicit MIME keys only (no wildcards)", () => {
+    expect(Object.keys(FILE_ROUTE_CONFIG).sort()).toEqual([...UPLOADABLE_MIME_TYPES].sort());
+    for (const key of Object.keys(FILE_ROUTE_CONFIG)) {
+      expect(["image", "video", "audio", "blob", "pdf", "text"]).not.toContain(key);
+    }
+  });
+
+  it("sanitizes filenames", () => {
+    const traversal = sanitizeFilename("../../etc/passwd");
+    expect(traversal).not.toMatch(/[\\/]/);
+    expect(traversal.startsWith(".")).toBe(false);
+    expect(sanitizeFilename("C:\\Users\\x\\a.png")).not.toMatch(/[\\/]/);
+    expect(sanitizeFilename("a\u0000b.png")).toBe("ab.png");
+    expect(sanitizeFilename("   ")).toBe("upload");
+  });
+
+  it("only trusts https UploadThing CDN hosts", () => {
+    expect(isTrustedUploadUrl("https://abc123.ufs.sh/f/key")).toBe(true);
+    expect(isTrustedUploadUrl("https://utfs.io/f/key")).toBe(true);
+    expect(isTrustedUploadUrl("http://abc.ufs.sh/f/key")).toBe(false);
+    expect(isTrustedUploadUrl("https://evil.example/f/key")).toBe(false);
+    expect(isTrustedUploadUrl("https://ufs.sh.evil.example/f/k")).toBe(false);
+    expect(isTrustedUploadUrl("https://evilufs.sh/f/k")).toBe(false);
+    expect(isTrustedUploadUrl("http://169.254.169.254/latest")).toBe(false);
+    expect(isTrustedUploadUrl("not a url")).toBe(false);
+  });
+});
diff --git a/tests/assets/upload-router.test.ts b/tests/assets/upload-router.test.ts
new file mode 100644
index 0000000..e9cf608
--- /dev/null
+++ b/tests/assets/upload-router.test.ts
@@ -0,0 +1,147 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const requireCampaignEditPermission = vi.fn();
+const folderBelongsToOrganization = vi.fn();
+const processUploadedFile = vi.fn();
+
+vi.mock("@/lib/auth/require-campaign-permission", () => ({
+  requireCampaignEditPermission: (...a: unknown[]) => requireCampaignEditPermission(...a),
+}));
+vi.mock("@/lib/assets/asset-repository", () => ({
+  folderBelongsToOrganization: (...a: unknown[]) => folderBelongsToOrganization(...a),
+}));
+vi.mock("@/lib/assets/process-upload-deps", () => ({ processUploadDeps: { marker: "deps" } }));
+vi.mock("@/lib/logger", () => ({
+  logger: { debug: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+vi.mock("@/lib/assets/process-upload", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("@/lib/assets/process-upload")>();
+  return { ...actual, processUploadedFile: (...a: unknown[]) => processUploadedFile(...a) };
+});
+
+import { AppError, ForbiddenError, UnauthenticatedError } from "@/lib/errors";
+import { UploadRejectedError } from "@/lib/assets/process-upload";
+import { ourFileRouter } from "@/app/api/uploadthing/core";
+
+// UploadThing v7 exposes the route's config/handlers directly on the route object.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const def = ourFileRouter.assetLibrary as any;
+
+const FOLDER = "22222222-2222-4222-8222-222222222222";
+const okFile = { name: "a.png", type: "image/png", size: 1000 };
+const run = (input: object, files: object[] = [okFile]) =>
+  def.middleware({ input, files, req: {}, event: {} });
+
+beforeEach(() => {
+  requireCampaignEditPermission.mockReset().mockResolvedValue({
+    organizationId: "org_1",
+    userId: "user_1",
+  });
+  folderBelongsToOrganization.mockReset().mockResolvedValue(true);
+  processUploadedFile.mockReset();
+});
+
+describe("upload router configuration", () => {
+  it("only declares explicit image MIME types (no video/audio/pdf/blob)", () => {
+    const keys = Object.keys(def.routerConfig);
+    expect(keys.sort()).toEqual(
+      ["image/avif", "image/gif", "image/jpeg", "image/png", "image/svg+xml", "image/webp"].sort(),
+    );
+  });
+
+  it("validates input with zod (campaignId required, folderId must be a uuid)", () => {
+    const parse = (v: unknown) => def.inputParser.safeParse(v).success;
+    expect(parse({ campaignId: "c" })).toBe(true);
+    expect(parse({ campaignId: "c", folderId: FOLDER })).toBe(true);
+    expect(parse({ campaignId: "c", folderId: null })).toBe(true);
+    expect(parse({})).toBe(false);
+    expect(parse({ campaignId: "c", folderId: "not-a-uuid" })).toBe(false);
+    expect(parse({ campaignId: "" })).toBe(false);
+  });
+});
+
+describe("middleware", () => {
+  it("derives organization/user from the AUTHORIZED campaign, not from input", async () => {
+    const meta = await run({ campaignId: "camp_1", folderId: null, organizationId: "org_EVIL" });
+    expect(requireCampaignEditPermission).toHaveBeenCalledWith("camp_1");
+    expect(meta).toEqual({ organizationId: "org_1", userId: "user_1", folderId: null });
+  });
+
+  it("authorizes BEFORE doing anything else", async () => {
+    requireCampaignEditPermission.mockRejectedValue(new UnauthenticatedError());
+    await expect(run({ campaignId: "c", folderId: FOLDER })).rejects.toMatchObject({ code: "FORBIDDEN" });
+    expect(folderBelongsToOrganization).not.toHaveBeenCalled();
+  });
+
+  it("a user without edit permission is rejected", async () => {
+    requireCampaignEditPermission.mockRejectedValue(new ForbiddenError());
+    await expect(run({ campaignId: "c" })).rejects.toMatchObject({ code: "FORBIDDEN" });
+  });
+
+  it("unexpected auth failures are generic (no internals leaked)", async () => {
+    requireCampaignEditPermission.mockRejectedValue(new Error("pg: password for user x"));
+    const err = await run({ campaignId: "c" }).catch((e: Error) => e);
+    expect(String(err.message)).not.toMatch(/pg|password/);
+    expect(err).toMatchObject({ code: "INTERNAL_SERVER_ERROR" });
+  });
+
+  it("rejects a folder from another organization", async () => {
+    folderBelongsToOrganization.mockResolvedValue(false);
+    await expect(run({ campaignId: "c", folderId: FOLDER })).rejects.toMatchObject({ code: "BAD_REQUEST" });
+    expect(folderBelongsToOrganization).toHaveBeenCalledWith("org_1", FOLDER);
+  });
+
+  it("accepts a folder of the organization and passes it through", async () => {
+    const meta = await run({ campaignId: "c", folderId: FOLDER });
+    expect(meta.folderId).toBe(FOLDER);
+  });
+
+  it.each([
+    ["video", { name: "v.mp4", type: "video/mp4", size: 1000 }],
+    ["pdf", { name: "d.pdf", type: "application/pdf", size: 1000 }],
+    ["html", { name: "x.html", type: "text/html", size: 1000 }],
+    ["oversize", { name: "big.png", type: "image/png", size: 9 * 1024 * 1024 }],
+    ["empty", { name: "e.png", type: "image/png", size: 0 }],
+  ])("rejects %s uploads before they start", async (_n, file) => {
+    await expect(run({ campaignId: "c" }, [file])).rejects.toMatchObject({ code: "BAD_REQUEST" });
+  });
+
+  it("limits files per upload", async () => {
+    await expect(run({ campaignId: "c" }, Array.from({ length: 11 }, () => okFile))).rejects.toMatchObject({
+      code: "TOO_MANY_FILES",
+    });
+  });
+});
+
+describe("onUploadComplete", () => {
+  const meta = { organizationId: "org_1", userId: "user_1", folderId: null };
+  const file = { key: "k", name: "a.png", size: 10, type: "image/png", ufsUrl: "https://a.ufs.sh/f/k", extra: "x" };
+  const asset = { id: "a1", filename: "a.png" };
+
+  it("persists via processUploadedFile with server-derived metadata and returns the asset", async () => {
+    processUploadedFile.mockResolvedValue(asset);
+    const out = await def.onUploadComplete({ metadata: meta, file });
+    expect(processUploadedFile).toHaveBeenCalledWith(
+      { key: "k", name: "a.png", size: 10, type: "image/png", ufsUrl: "https://a.ufs.sh/f/k" },
+      meta,
+      { marker: "deps" },
+    );
+    expect(out).toEqual({ asset });
+  });
+
+  it("surfaces user-safe rejection messages", async () => {
+    processUploadedFile.mockRejectedValue(new UploadRejectedError("File is not a valid image."));
+    await expect(def.onUploadComplete({ metadata: meta, file })).rejects.toMatchObject({
+      message: "File is not a valid image.",
+    });
+  });
+
+  it("hides unexpected errors behind a generic message", async () => {
+    processUploadedFile.mockRejectedValue(new Error("ECONNREFUSED 10.0.0.5:5432"));
+    const err = await def.onUploadComplete({ metadata: meta, file }).catch((e: Error) => e);
+    expect(err.message).not.toMatch(/ECONNREFUSED|10\.0/);
+    expect(err.message).toMatch(/could not be saved/i);
+  });
+});
+
+void AppError;
diff --git a/tests/assets/video-embed.test.ts b/tests/assets/video-embed.test.ts
new file mode 100644
index 0000000..f83056c
--- /dev/null
+++ b/tests/assets/video-embed.test.ts
@@ -0,0 +1,132 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildVideoEmbedUrl,
+  isAllowedEmbedUrl,
+  parseVideoInput,
+} from "@/lib/video-embed";
+
+const YT = "dQw4w9WgXcQ";
+const LOOM = "0123456789abcdef0123456789abcdef";
+
+describe("parseVideoInput — YouTube", () => {
+  it.each([
+    [`https://www.youtube.com/watch?v=${YT}`],
+    [`https://youtube.com/watch?v=${YT}&t=10s`],
+    [`https://m.youtube.com/watch?v=${YT}`],
+    [`https://youtu.be/${YT}`],
+    [`https://youtu.be/${YT}?si=abc`],
+    [`https://www.youtube.com/embed/${YT}`],
+    [`https://www.youtube-nocookie.com/embed/${YT}`],
+    [`https://www.youtube.com/shorts/${YT}`],
+    [`https://www.youtube.com/live/${YT}`],
+    [`www.youtube.com/watch?v=${YT}`],
+    [`  ${YT}  `],
+  ])("parses %s", (input) => {
+    expect(parseVideoInput(input)).toEqual({ provider: "youtube", video_id: YT });
+  });
+});
+
+describe("parseVideoInput — Loom", () => {
+  it.each([
+    [`https://www.loom.com/share/${LOOM}`],
+    [`https://loom.com/share/${LOOM}?sid=x`],
+    [`https://www.loom.com/embed/${LOOM}`],
+  ])("parses %s", (input) => {
+    expect(parseVideoInput(input)).toEqual({ provider: "loom", video_id: LOOM });
+  });
+
+  it("accepts a bare Loom id only when Loom is the preferred provider", () => {
+    expect(parseVideoInput(LOOM)).toBeNull();
+    expect(parseVideoInput(LOOM, "loom")).toEqual({ provider: "loom", video_id: LOOM });
+  });
+});
+
+describe("parseVideoInput — rejects", () => {
+  it.each([
+    "", "   ", "not a url",
+    "javascript:alert(1)",
+    "data:text/html,<script>alert(1)</script>",
+    "ftp://www.youtube.com/watch?v=" + YT,
+    "https://evil.example/watch?v=" + YT,
+    "https://youtube.com.evil.example/watch?v=" + YT,
+    "https://www.youtube.com.evil.example/embed/" + YT,
+    "https://evilyoutube.com/watch?v=" + YT,
+    "https://user:pass@www.youtube.com/watch?v=" + YT,
+    "https://www.youtube.com/watch?v=short",
+    "https://www.youtube.com/watch?v=" + YT + "<script>",
+    "https://www.youtube.com/embed/../watch",
+    "https://www.youtube.com/watch",
+    "https://www.youtube.com/channel/UC123",
+    "https://www.loom.com/share/not-a-hex-id",
+    "https://vimeo.com/123456",
+  ])("%s", (input) => {
+    expect(parseVideoInput(input)).toBeNull();
+  });
+});
+
+describe("buildVideoEmbedUrl", () => {
+  it("builds YouTube embed URLs with options", () => {
+    expect(buildVideoEmbedUrl({ provider: "youtube", video_id: YT })).toBe(
+      `https://www.youtube.com/embed/${YT}`,
+    );
+    expect(
+      buildVideoEmbedUrl({ provider: "youtube", video_id: YT }, { privacyMode: true, muted: true, controls: false }),
+    ).toBe(`https://www.youtube-nocookie.com/embed/${YT}?mute=1&controls=0`);
+    expect(
+      buildVideoEmbedUrl({ provider: "youtube", video_id: YT }, { loop: true }),
+    ).toBe(`https://www.youtube.com/embed/${YT}?loop=1&playlist=${YT}`);
+  });
+
+  it("builds Loom embed URLs", () => {
+    expect(buildVideoEmbedUrl({ provider: "loom", video_id: LOOM })).toBe(
+      `https://www.loom.com/embed/${LOOM}`,
+    );
+  });
+
+  it.each([
+    ["x/../../redirect"],
+    [`${YT}?autoplay=1&evil=1`],
+    [`${YT}#frag`],
+    ["https://evil.example/x"],
+    ["//evil.example"],
+    ["javascript:alert(1)"],
+    [""],
+    ["a b c d e f g"],
+    ["{{cms.field}}"],
+  ])("refuses unvalidated YouTube id %j", (id) => {
+    expect(buildVideoEmbedUrl({ provider: "youtube", video_id: id })).toBeNull();
+  });
+
+  it("refuses unknown providers and prototype tricks", () => {
+    expect(buildVideoEmbedUrl({ provider: "vimeo", video_id: "123" })).toBeNull();
+    expect(buildVideoEmbedUrl({ provider: "__proto__", video_id: YT })).toBeNull();
+    expect(buildVideoEmbedUrl({ provider: "constructor", video_id: YT })).toBeNull();
+    expect(buildVideoEmbedUrl({ provider: "youtube", video_id: YT.repeat(2) })).toBeNull();
+  });
+
+  it("every produced URL passes the origin allow-list", () => {
+    for (const url of [
+      buildVideoEmbedUrl({ provider: "youtube", video_id: YT }),
+      buildVideoEmbedUrl({ provider: "youtube", video_id: YT }, { privacyMode: true }),
+      buildVideoEmbedUrl({ provider: "loom", video_id: LOOM }),
+    ]) {
+      expect(url && isAllowedEmbedUrl(url)).toBe(true);
+    }
+  });
+});
+
+describe("isAllowedEmbedUrl", () => {
+  it.each([
+    ["https://www.youtube.com/embed/x", true],
+    ["https://www.loom.com/embed/x", true],
+    ["http://www.youtube.com/embed/x", false],
+    ["https://youtube.com/embed/x", false],
+    ["https://www.youtube.com.evil.example/embed/x", false],
+    ["https://evil.example/embed/x", false],
+    ["https://user@www.youtube.com/embed/x", false],
+    ["javascript:alert(1)", false],
+    ["", false],
+  ])("%s → %s", (url, expected) => {
+    expect(isAllowedEmbedUrl(url)).toBe(expected);
+  });
+});
